    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Add a new field called 'myNewField' to the JSON of the item\nlet resultado = \"saludable\";\n\nif ($json.nutriscore === \"c\") {\n  resultado = \"moderado\";\n}\n\nif ($json.nutriscore === \"d\" || $json.nutriscore === \"e\") {\n  resultado = \"no saludable\";\n}\n\nreturn {\n  ...$json,\n  resultado_nutriscore: resultado\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        -304
      ],
      "id": "ccf3a972-b525-4788-8261-89999bb23982",
      "name": "Comprobacion de saludable"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Add a new field called 'myNewField' to the JSON of the item\nlet altos = 0;\n\nif ($json.azucar > 22.5) {\n  altos++;\n}\n\nif ($json.sal > 1.5) {\n  altos++;\n}\n\nif ($json.grasa > 17.5) {\n  altos++;\n}\n\nlet semaforo = \"saludable\";\n\nif (altos == 1) {\n  semaforo = \"moderado\";\n}\n\nif (altos >= 2) {\n  semaforo = \"no saludable\";\n}\n\nreturn {\n  ...$json,\n  nutrientes_altos: altos,\n  semaforo: semaforo\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -256
      ],
      "id": "055cbf01-57c7-475c-8b5e-bf34bc8bb542",
      "name": "Comprobacion Nutrientes + Semaforo"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Add a new field called 'myNewField' to the JSON of the item\nlet resultado = \"saludable\";\n\nif ($json.semaforo == \"moderado\" || $json.resultado_nutriscore == \"moderado\") {\n  resultado = \"moderado\";\n}\n\nif ($json.semaforo == \"no saludable\" || $json.resultado_nutriscore == \"no saludable\") {\n  resultado = \"no saludable\";\n}\n\nreturn {\n  ...$json,\n  resultado: resultado\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
